NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_KEY=your-app-key
LOG_LEVEL=info

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=hrms

# Clerk / Auth
JWKS_URL=https://your-clerk-domain/.well-known/jwks.json
CLERK_SIGNUP_URL=https://your-clerk-domain/sign-up
INVITATION_REDIRECT_URL=https://hrms.example.com/invitation/accept
INVITATION_DEFAULT_EMAIL=admin@example.com

# AWS / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret
S3_BUCKET=your-s3-bucket

# Frontend
FRONTEND_URL=https://hrms.example.com

# Email / Brevo
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=no-reply@example.com

# Branding
COMPANY_NAME=Fibonacci Innovations
COMPANY_BRAND_COLOR=#0066FF
COMPANY_ACCENT_COLOR=#4318FF
COMPANY_LOGO_URL=https://your-hrms-portal.com/logo.png

